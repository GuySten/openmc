  <geometry>
    <cell id="1" material="1" region="-1" universe="1"/>
    <cell id="2" material="2" region="1 -2" universe="1"/>
    <cell id="3" material="3" region="2 -3" universe="1"/>
    <surface id="1" type="sphere" coeffs="0.0 0.0 0.0 0.1"/>
    <surface id="2" type="sphere" coeffs="0.0 0.0 0.0 0.15"/>
    <surface id="3" type="sphere" boundary="vacuum" coeffs="0.0 0.0 0.0 5.0"/>
  </geometry>
  <settings>
    <run_mode>fixed source</run_mode>
    <particles>1000</particles>
    <batches>2</batches>
    <source type="independent" strength="2.0" particle="electron">
      <space type="spherical" origin="0.0 0.0 0.0">
        <r type="powerlaw" parameters="0.0 0.1 2"/>
        <cos_theta type="uniform" parameters="-1.0 1.0"/>
        <phi type="uniform" parameters="0.0 6.283185307179586"/>
      </space>
      <energy type="mixture">
        <pair probability="1.0">
          <dist type="beta" parameters="546000.0 39 90 0.0" forbiddenness="1" unique="true"/>
        </pair>
        <pair probability="1.0">
          <dist type="beta" parameters="2279800.0 40 90 0.0" forbiddenness="1" unique="true"/>
        </pair>
      </energy>
    </source>
    <source type="independent" strength="1.0" particle="positron">
      <space type="spherical" origin="0.0 0.0 0.0">
        <r type="powerlaw" parameters="0.0 0.1 2"/>
        <cos_theta type="uniform" parameters="-1.0 1.0"/>
        <phi type="uniform" parameters="0.0 6.283185307179586"/>
      </space>
      <energy type="beta" parameters="545700.0 10 22 0.0" positron="true"/>
    </source>
    <photon_transport>true</photon_transport>
  </settings>
  <tallies>
    <filter id="1" type="particle">
      <bins>electron positron photon</bins>
    </filter>
    <filter id="2" type="cell">
      <bins>1 2 3</bins>
    </filter>
    <filter id="3" type="particle">
      <bins>photon</bins>
    </filter>
    <filter id="4" type="energy">
      <bins>0.0 100000.0 500000.0 511000.0 1000000.0 2500000.0</bins>
    </filter>
    <tally id="1">
      <filters>1 2</filters>
      <scores>heating</scores>
    </tally>
    <tally id="2">
      <filters>3 4</filters>
      <scores>flux</scores>
    </tally>
  </tallies>
